# ============================================================
# APPLICATION
# ============================================================

ENV_MODE=development

APP_NAME=Mechanic System API
APP_VERSION=0.1.0

API_V1_PREFIX=/api

LOG_LEVEL=INFO

BACKEND_PORT=8000

# ============================================================
# CORS
# ============================================================

CORS_ALLOW_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:5200,http://127.0.0.1:5200

# ============================================================
# DATABASE
# ============================================================

SQL_ECHO=false

POSTGRES_SERV=serv-mech-db
POSTGRES_DB=mechanic_db
POSTGRES_USER=mechanic_user
POSTGRES_PASSWORD=mechanic_password

POSTGRES_PORT=5432
POSTGRES_HOST_PORT=55432

# ============================================================
# JWT
# ============================================================

SECRET_KEY=change-me-in-local-env

JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ============================================================
# AUTH COOKIES
# ============================================================

COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax

COOKIE_DOMAIN=
COOKIE_PATH=/

ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token

# ============================================================
# SESSION
# ============================================================

SESSION_EXPIRE_MINUTES=10080

# ============================================================
# SECURITY
# ============================================================

TRUSTED_HOSTS=localhost,127.0.0.1

DOCS_ENABLED_IN_PRODUCTION=false
SECURITY_HEADERS_ENABLED=true
HTTPS_REDIRECT_ENABLED=false

# ============================================================
# BOOTSTRAP
# ============================================================

BOOTSTRAP_SEED_ENABLED=true

# ============================================================
# AUDIT
# ============================================================

AUDIT_ENABLED=true

# ============================================================
# INITIAL SUPERADMIN
# ============================================================

INITIAL_PLATFORM_ADMIN_EMAIL=admin@mechanic.com
INITIAL_PLATFORM_ADMIN_PASSWORD=ChangeMe12345!

INITIAL_PLATFORM_ADMIN_FIRST_NAME=Platform
INITIAL_PLATFORM_ADMIN_LAST_NAME=Admin
INITIAL_PLATFORM_ADMIN_PHONE=70000001

# ============================================================
# FRONTEND
# ============================================================

FRONTEND_PORT=4200

NOTIFICATIONS_PUSH_ENABLED=true
NOTIFICATIONS_PROVIDER=FIREBASE
FIREBASE_CREDENTIALS_PATH=app/firebase/mechanic-system.json
FIREBASE_PROJECT_ID=mechanic-system-60380



# ============================================================
# IA INTEGRATION
# ============================================================

#OPENAI o GEMINI
AI_ENABLED=true
AI_PROVIDER=GEMINI

AI_TIMEOUT_SECONDS=30
AI_DEFAULT_TEMPERATURE=0.2
AI_DEFAULT_MAX_OUTPUT_TOKENS=2048



#first option
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_JSON_MODEL=gemini-flash-latest

#second option
OPENAI_API_KEY=xxxxxxxx
OPENAI_MODEL=gpt-5
OPENAI_JSON_MODEL=gpt-5


#============= GOOGLE MAPS ===================
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=
WS_BASE_URL=


FIREBASE_API_KEY=...
FIREBASE_AUTH_DOMAIN=mechanic-system-60380.firebaseapp.com
FIREBASE_PROJECT_ID=mechanic-system-60380
FIREBASE_STORAGE_BUCKET=mechanic-system-60380.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=...
FIREBASE_APP_ID=...
FIREBASE_VAPID_KEY=...
APP_VERSION=0.1.0



